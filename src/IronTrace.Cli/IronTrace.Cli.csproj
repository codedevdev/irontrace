<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>IronTrace.Cli</RootNamespace>
    <AssemblyName>irontrace</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IronTrace.Contracts\IronTrace.Contracts.csproj" />
    <ProjectReference Include="..\IronTrace.Core\IronTrace.Core.csproj" />
    <ProjectReference Include="..\IronTrace.Windows\IronTrace.Windows.csproj" />
    <ProjectReference Include="..\IronTrace.Hardware\IronTrace.Hardware.csproj" />
    <ProjectReference Include="..\IronTrace.Fingerprints\IronTrace.Fingerprints.csproj" />
    <ProjectReference Include="..\IronTrace.RiskEngine\IronTrace.RiskEngine.csproj" />
    <ProjectReference Include="..\IronTrace.Reporting\IronTrace.Reporting.csproj" />
    <ProjectReference Include="..\IronTrace.Forensics\IronTrace.Forensics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\data\reference\pci-reference.db" Link="reference\pci-reference.db" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\reference\pci-reference.db')" />
    <Content Include="..\..\data\reference\usb-reference.db" Link="reference\usb-reference.db" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\reference\usb-reference.db')" />
    <Content Include="..\..\data\reference\loldrivers-reference.db" Link="reference\loldrivers-reference.db" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\reference\loldrivers-reference.db')" />
    <Content Include="..\..\data\reference\dma-watchlist.json" Link="reference\dma-watchlist.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\reference\dma-watchlist.json')" />
    <Content Include="..\..\data\reference\cheat-signatures.json" Link="reference\cheat-signatures.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\reference\cheat-signatures.json')" />
    <Content Include="..\..\data\reference\ms-vulnerable-driver-blocklist.json" Link="reference\ms-vulnerable-driver-blocklist.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\data\reference\ms-vulnerable-driver-blocklist.json')" />
  </ItemGroup>
</Project>
